# docker build -f docker/Dockerfile.next --build-arg APP=web .   (web, admin or docs)
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
ARG APP
ARG NEXT_PUBLIC_GOOGLE_SIGN_IN=false
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .eslintrc.cjs ./
COPY packages packages
COPY apps/${APP} apps/${APP}
RUN pnpm install --frozen-lockfile --filter "@vashundhara-foundation/${APP}..." --filter vashundhara-foundation
RUN pnpm turbo run build --filter=@vashundhara-foundation/${APP} && mkdir -p apps/${APP}/public apps/${APP}/content

FROM node:22-alpine AS runner
ARG APP
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=node:node /app/apps/${APP}/public ./apps/${APP}/public
COPY --from=build --chown=node:node /app/apps/${APP}/content ./apps/${APP}/content
WORKDIR /app/apps/${APP}
USER node
EXPOSE 3000
CMD ["node", "server.js"]
