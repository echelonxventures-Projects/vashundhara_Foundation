{
  "name": "vashundhara-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise-grade multi-tenant, multi-lingual, multi-currency platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "build:web": "turbo run build --filter=web",
    "build:admin": "turbo run build --filter=admin",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "db:generate": "turbo run db:generate --filter=database",
    "db:migrate": "turbo run db:migrate --filter=database",
    "db:migrate:create": "turbo run db:migrate:create --filter=database",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=database",
    "db:seed": "turbo run db:seed --filter=database",
    "db:studio": "turbo run db:studio --filter=database",
    "db:reset": "turbo run db:reset --filter=database",
    "generate:module": "turbo run generate:module --filter=api",
    "generate:crud": "turbo run generate:crud --filter=api",
    "depcheck:circular": "turbo run depcheck:circular",
    "analyze:web": "turbo run analyze:web --filter=web",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0"
  }
}