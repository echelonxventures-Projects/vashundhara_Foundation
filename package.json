{
  "name": "vashundhara-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise-grade multi-tenant, multi-lingual, multi-currency platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@vashundhara-foundation/api",
    "build:web": "turbo run build --filter=@vashundhara-foundation/web",
    "build:admin": "turbo run build --filter=@vashundhara-foundation/admin",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @vashundhara-foundation/database db:generate",
    "db:migrate": "pnpm --filter @vashundhara-foundation/database db:migrate",
    "db:migrate:create": "pnpm --filter @vashundhara-foundation/database db:migrate:create",
    "db:migrate:deploy": "pnpm --filter @vashundhara-foundation/database db:migrate:deploy",
    "db:seed": "pnpm --filter @vashundhara-foundation/database db:seed",
    "db:studio": "pnpm --filter @vashundhara-foundation/database db:studio",
    "db:reset": "pnpm --filter @vashundhara-foundation/database db:reset",
    "generate:module": "tsx tooling/generators/module.ts",
    "prepare": "husky",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "import:wordpress": "tsx tooling/scripts/wpress-import.ts",
    "db:create-admin": "pnpm --filter @vashundhara-foundation/database db:create-admin"
  },
  "devDependencies": {
    "@turbo/gen": "^2.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "~5.9.0",
    "tsx": "^4.20.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
