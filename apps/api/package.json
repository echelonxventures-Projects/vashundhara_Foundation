{
  "name": "@vashundhara-foundation/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate:module": "tsx ../../tooling/generators/module.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-presigned-post": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "~6.19.0",
    "@sentry/node": "^10.0.0",
    "@vashundhara-foundation/auth": "workspace:*",
    "@vashundhara-foundation/database": "workspace:*",
    "@vashundhara-foundation/feature-flags": "workspace:*",
    "@vashundhara-foundation/shared": "workspace:*",
    "bidi-js": "1.1.0",
    "cookie-parser": "^1.4.7",
    "harfbuzzjs": "0.10.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nodemailer": "^10.0.6",
    "pdfkit": "^0.17.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
