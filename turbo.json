{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "test:e2e": {
      "outputs": [],
      "dependsOn": ["build"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "db:migrate": {
      "outputs": ["prisma/migrations/**"]
    },
    "db:migrate:create": {
      "outputs": ["prisma/migrations/**"]
    },
    "db:migrate:deploy": {
      "outputs": []
    },
    "db:seed": {
      "outputs": []
    },
    "db:studio": {
      "cache": false
    },
    "db:reset": {
      "outputs": []
    },
    "generate:module": {
      "cache": false
    },
    "generate:crud": {
      "cache": false
    },
    "depcheck:circular": {
      "outputs": []
    },
    "analyze:web": {
      "outputs": []
    }
  },
  "globalDependencies": [".env*"],
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "EXCHANGE_RATE_API_KEY"]
}