# Vashundhara Foundation - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://vashundhara:changeme@localhost:5432/vashundhara?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# JWT Expiry
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# EXCHANGE RATE API
# ============================================
# Get free key at: https://exchangerate-api.com/
EXCHANGE_RATE_API_KEY="your-exchange-rate-api-key"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
PORT=3000
API_PREFIX="api"
API_VERSION="1"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"
LOG_LEVEL="debug"

# Frontend URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# ============================================
# EMAIL (Optional)
# ============================================
# SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@vashundharafoundation.org"
SENDGRID_FROM_NAME="Vashundhara Foundation"

# Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL="noreply@vashundharafoundation.org"

# SMTP (fallback)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@vashundharafoundation.org"

# ============================================
# SMS (Optional)
# ============================================
# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# MSG91 (India)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# ============================================
# STORAGE (Optional)
# ============================================
# MinIO (S3-compatible local)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="vashundhara"

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Datadog
DATADOG_API_KEY=""
DATADOG_APP_KEY=""
DATADOG_SITE="datadoghq.com"

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_FLAG_PROVIDER="database"

# ============================================
# PAYMENT GATEWAYS (Optional)
# ============================================
# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================
# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Microsoft
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ============================================
# WEBHOOKS
# ============================================
WEBHOOK_SECRET="your-webhook-secret-key"
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=1000