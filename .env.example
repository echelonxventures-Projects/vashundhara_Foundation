# ---- REQUIRED ----
DATABASE_URL=postgresql://vf:vf@localhost:5432/vf
REDIS_URL=redis://localhost:6379
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   Keep an offline copy: encrypted data cannot be read without it.
ENCRYPTION_KEY=

# ---- Addresses ----
NODE_ENV=development
PORT=3000
ROOT_DOMAIN=localhost
APP_URL=http://localhost:3001
DEFAULT_TENANT_SLUG=vashundhara
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# Where the web and admin servers reach the API
API_INTERNAL_URL=http://localhost:3000
# Required in production, same value for api, web and admin. openssl rand -hex 24
INTERNAL_PROXY_SECRET=
TRUST_PROXY_HOPS=0
WORKER_ENABLED=true
SIGNUP_NGO_ENABLED=true

# ---- Email (required in production) ----
SMTP_URL=
EMAIL_FROM=no-reply@localhost

# ---- File storage and virus scan (required in production) ----
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Storage address allowed for browser uploads, for example https://s3.ap-south-1.amazonaws.com
CSP_UPLOAD_ORIGIN=

# ---- Optional ----
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
EXCHANGE_RATE_API_KEY=
SENTRY_DSN=
METRICS_TOKEN=
LOG_LEVEL=info
