{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@vashundhara-foundation/api": ["apps/api/src"],
      "@vashundhara-foundation/web": ["apps/web/src"],
      "@vashundhara-foundation/admin": ["apps/admin/src"],
      "@vashundhara-foundation/config": ["packages/config/src"],
      "@vashundhara-foundation/database": ["packages/database/src"],
      "@vashundhara-foundation/shared": ["packages/shared/src"],
      "@vashundhara-foundation/ui": ["packages/ui/src"],
      "@vashundhara-foundation/i18n": ["packages/i18n/src"],
      "@vashundhara-foundation/auth": ["packages/auth/src"],
      "@vashundhara-foundation/feature-flags": ["packages/feature-flags/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo"]
}