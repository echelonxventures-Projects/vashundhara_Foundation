  contactPerson  String?
  contactPhone   String?
  contactEmail   String?           @db.Citext
  tags           String[]          @default([])
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
