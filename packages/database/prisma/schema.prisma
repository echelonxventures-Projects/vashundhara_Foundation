generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  slug                  String                 @unique @db.Citext
  name                  String
  displayName           String?
  description           String?
  logoUrl               String?
  faviconUrl            String?
  primaryDomain         String?                @unique
  status                TenantStatus           @default(PENDING_SETUP)
  defaultCurrency       CurrencyCode           @default(INR)
  defaultLocale         LocaleCode             @default(en)
  supportedCurrencies   CurrencyCode[]         @default([INR])
  supportedLocales      LocaleCode[]           @default([en])
  timezone              String                 @default("Asia/Kolkata")
  settings              Json                   @default("{}")
  metadata              Json                   @default("{}")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  auditLogs             AuditLog[]
  currencies            Currency[]
  exchangeRates         ExchangeRate[]
  featureFlags          FeatureFlag[]
  files                 File[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  roles                 Role[]
  tenantConfigs         TenantConfig[]         @relation("TenantConfigs")
  translations          Translation[]
  webhooks              Webhook[]
  contacts              Contact[]
  organizations         Organization[]
  pipelines             Pipeline[]
  deals                 Deal[]
  crmActivities         CrmActivity[]
  volunteers            Volunteer[]
  shifts                Shift[]
  shiftAssignments      ShiftAssignment[]
  skills                Skill[]
  hoursLogs             HoursLog[]
  availabilities        Availability[]
  memberships           Membership[]
  invitations           Invitation[]
  campaigns             Campaign[]
  donors                Donor[]
  donations             Donation[]
  payments              Payment[]
  refunds               Refund[]
  subscriptions         Subscription[]
  receipts              Receipt[]
  receiptCounters       ReceiptCounter[]
  ledgerEntrys          LedgerEntry[]
  paymentAccounts       PaymentAccount[]
  beneficiarys          Beneficiary[]
  beneficiaryCases      BeneficiaryCase[]
  aidRecords            AidRecord[]
  fieldVisits           FieldVisit[]
  fieldAttendances      FieldAttendance[]
  certificates          Certificate[]
  grants                Grant[]
  grantUtilisations     GrantUtilisation[]
  invoices              Invoice[]
  pages                 Page[]
  redirects             Redirect[]
  contactMessages       ContactMessage[]
  newsletterSubscribers NewsletterSubscriber[]
  consentRecords        ConsentRecord[]
  dataRequests          DataRequest[]
  pushSubscriptions     PushSubscription[]
  reportSchedules       ReportSchedule[]
  apiKeys               ApiKey[]
  complianceProfile     ComplianceProfile?
  events                Event[]
  eventRegistrations    EventRegistration[]
  students              Student[]
  courses               Course[]
  lessons               Lesson[]
  enrolments            Enrolment[]
  lessonProgresses      LessonProgress[]
  liveClasss            LiveClass[]
  classAttendances      ClassAttendance[]
  assignments           Assignment[]
  submissions           Submission[]
  libraryItems          LibraryItem[]
  libraryAccesses       LibraryAccess[]
  feedbacks             Feedback[]
  socialPosts           SocialPost[]
  programmes            Programme[]
  indicators            Indicator[]
  indicatorReadings     IndicatorReading[]
  structurePolicy       StructurePolicy?
  structureVersions     StructureVersion[]
  customValues          CustomValue[]
  customRecords         CustomRecord[]

  @@index([status])
  @@index([primaryDomain])
  @@map("tenants")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique @db.Citext
  emailVerified     Boolean            @default(false)
  phone             String?            @unique
  phoneVerified     Boolean            @default(false)
  passwordHash      String?
  googleSub         String?            @unique
  firstName         String
  lastName          String
  displayName       String?
  avatarUrl         String?
  locale            LocaleCode         @default(en)
  timezone          String             @default("Asia/Kolkata")
  status            UserStatus         @default(PENDING_VERIFICATION)
  isSystemAdmin Boolean @default(false)
  mfaEnabled        Boolean            @default(false)
  mfaSecretEnc      String?
  mfaBackupHashes   String[]           @default([])
  mfaLastStep       Int?
  failedLogins      Int                @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  metadata          Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  sessions          Session[]
  memberships       Membership[]
  authTokens        AuthToken[]
  donors            Donor[]
  volunteers        Volunteer[]
  beneficiaries     Beneficiary[]
  pushSubscriptions PushSubscription[]
  uploadedFiles     File[]             @relation("FileUploadedBy")
  assignedDeals     Deal[]             @relation("DealAssignee")
  students          Student[]

  @@map("users")
}

/// A user's place in one NGO. One email can belong to many NGOs.
model Membership {
  id             String           @id @default(uuid())
  userId         String
  tenantId       String
  status         MembershipStatus @default(ACTIVE)
  organizationId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  roles          MembershipRole[]

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("memberships")
}

model MembershipRole {
  id           String     @id @default(uuid())
  membershipId String
  roleId       String
  assignedBy   String?
  assignedAt   DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model Invitation {
  id             String    @id @default(uuid())
  tenantId       String
  email          String    @db.Citext
  roleIds        String[]
  organizationId String?
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshHash  String    @unique
  previousHash String?   @unique
  rotatedAt    DateTime?
  tenantId     String?
  rememberMe   Boolean   @default(false)
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  tenantId    String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  permissions String[]  @default([])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("api_keys")
}

model Role {
  id          String           @id @default(uuid())
  name        String
  displayName String
  description String?
  scope       RoleScope        @default(TENANT)
  isSystem    Boolean          @default(false)
  priority    Int              @default(0)
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  tenantId    String?
  permissions RolePermission[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberRoles MembershipRole[]

  @@unique([name, tenantId, scope])
  @@index([tenantId, scope])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  conditions   Json?
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model SystemConfig {
  id               String   @id @default(uuid())
  key              String   @unique
  value            Json
  description      String?
  category         String
  isPublic         Boolean  @default(false)
  isEditable       Boolean  @default(true)
  validationSchema Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@map("system_configs")
}

model TenantConfig {
  id           String   @id @default(uuid())
  tenantId     String
  key          String
  value        Json
  description  String?
  category     String
  isOverridden Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation("TenantConfigs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, category])
  @@map("tenant_configs")
}

model FeatureFlag {
  id                String          @id @default(uuid())
  key               String
  name              String
  description       String?
  type              FeatureFlagType @default(BOOLEAN)
  defaultValue      Json
  isEnabled         Boolean         @default(false)
  rolloutPercentage Int             @default(0)
  targetingRules    Json?
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  tenantId          String?
  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, tenantId])
  @@index([tenantId, isEnabled])
  @@map("feature_flags")
}

model Locale {
  id           String        @id @default(uuid())
  code         LocaleCode    @unique
  name         String
  nativeName   String
  rtl          Boolean       @default(false)
  dateFormat   String        @default("dd/MM/yyyy")
  timeFormat   String        @default("HH:mm")
  numberFormat Json          @default("{}")
  pluralRules  Json          @default("{}")
  isActive     Boolean       @default(true)
  isSystem     Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]

  @@map("locales")
}

model Translation {
  id         String   @id @default(uuid())
  namespace  String
  key        String
  value      String
  context    String?
  isReviewed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenantId   String?
  localeId   String
  locale     Locale   @relation(fields: [localeId], references: [id], onDelete: Cascade)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([namespace, key, localeId, tenantId])
  @@index([namespace, localeId, tenantId])
  @@index([tenantId])
  @@map("translations")
}

model Currency {
  id                  String         @id @default(uuid())
  code                CurrencyCode   @unique
  symbol              String
  symbolPosition      String         @default("prefix")
  decimals            Int            @default(2)
  name                String
  namePlural          String
  isActive            Boolean        @default(true)
  isBase              Boolean        @default(false)
  formatting          Json           @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenantId            String?
  tenant              Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseExchangeRates   ExchangeRate[] @relation("BaseCurrency")
  targetExchangeRates ExchangeRate[] @relation("TargetCurrency")

  @@unique([code, tenantId])
  @@index([tenantId, isActive])
  @@map("currencies")
}

model ExchangeRate {
  id               String    @id @default(uuid())
  baseCurrencyId   String
  targetCurrencyId String
  rate             Decimal   @db.Decimal(18, 8)
  source           String    @default("exchangerate-api.com")
  fetchedAt        DateTime  @default(now())
  validFrom        DateTime  @default(now())
  validUntil       DateTime?
  isManual         Boolean   @default(false)
  tenantId         String?
  baseCurrency     Currency  @relation("BaseCurrency", fields: [baseCurrencyId], references: [id], onDelete: Cascade)
  targetCurrency   Currency  @relation("TargetCurrency", fields: [targetCurrencyId], references: [id], onDelete: Cascade)
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([baseCurrencyId, targetCurrencyId, validFrom, tenantId])
  @@index([tenantId, baseCurrencyId, targetCurrencyId])
  @@index([validFrom, validUntil])
  @@map("exchange_rates")
}

model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  resource      String
  resourceId    String?
  resourceType  String?
  oldValues     Json?
  newValues     Json?
  metadata      Json        @default("{}")
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime    @default(now())
  tenantId      String?
  userId        String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user          User?       @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@index([tenantId, userId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  key           String
  name          String
  description   String?
  channel       NotificationChannel
  subject       String?
  content       String
  contentHtml   String?
  locale        LocaleCode          @default(en)
  variables     Json                @default("[]")
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenantId      String?
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([key, locale, tenantId])
  @@index([tenantId, channel, isActive])
  @@map("notification_templates")
}

model Notification {
  id            String                @id @default(uuid())
  templateId    String?
  channel       NotificationChannel
  recipient     String
  subject       String?
  content       String
  contentHtml   String?
  status        NotificationStatus    @default(PENDING)
  priority      Int                   @default(0)
  scheduledAt   DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  retryCount    Int                   @default(0)
  maxRetries    Int                   @default(3)
  metadata      Json                  @default("{}")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenantId      String
  userId        String?
  template      NotificationTemplate? @relation(fields: [templateId], references: [id])
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?                 @relation(fields: [userId], references: [id])

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, userId, createdAt])
  @@index([templateId])
  @@map("notifications")
}

model Webhook {
  id           String            @id @default(uuid())
  name         String
  url          String
  secret       String
  events       WebhookEvent[]
  isActive     Boolean           @default(true)
  timeoutMs    Int               @default(30000)
  maxRetries   Int               @default(3)
  retryDelayMs Int               @default(1000)
  headers      Json              @default("{}")
  metadata     Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  tenantId     String
  deliveries   WebhookDelivery[]
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String        @id @default(uuid())
  webhookId      String
  event          WebhookEvent
  payload        Json
  responseStatus Int?
  responseBody   String?
  status         WebhookStatus @default(PENDING)
  attempt        Int           @default(1)
  error          String?
  nextRetryAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  webhook        Webhook       @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status, nextRetryAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model File {
  id           String     @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         BigInt
  path         String
  bucket       String
  checksum     String?
  status       FileStatus @default(PENDING)
  scanResult   String?
  metadata     Json       @default("{}")
  isPublic     Boolean    @default(false)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  tenantId     String
  uploadedById String?
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User?      @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, mimeType])
  @@index([checksum])
  @@map("files")
}

// ============================================
// CRM Models
// ============================================

model Contact {
  id              String        @id @default(uuid())
  firstName       String
  lastName        String
  email           String?       @db.Citext
  phone           String?
  mobile          String?
  whatsapp        String?
  jobTitle        String?
  department      String?
  source          String?
  status          ContactStatus @default(NEW)
  leadScore       Int           @default(0)
  tags            String[]      @default([])
  notes           String?
  address         Json?
  socialLinks     Json?
  metadata        Json?
  lastContactedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  tenantId        String
  organizationId  String?
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deals           Deal[]
  activities      CrmActivity[]

  @@unique([email, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, organizationId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, mobile])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

model Organization {
  id          String            @id @default(uuid())
  name        String
  legalName   String?
  website     String?
  industry    String?
  size        OrganizationSize?
  revenue     Decimal?          @db.Decimal(18, 2)
  description String?
  logoUrl     String?
  address     Json?
  phone       String?
  email       String?           @db.Citext
  gstNumber   String?
  panNumber   String?
  tags        String[]          @default([])
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  deals       Deal[]
  activities  CrmActivity[]
  memberships Membership[]
  grants      Grant[]
  invoices    Invoice[]
  donors      Donor[]

  @@index([tenantId, name])
  @@index([tenantId, industry])
  @@index([tenantId, email])
  @@index([tenantId, gstNumber])
  @@index([tenantId, createdAt])
  @@map("organizations")
}

model Pipeline {
  id             String          @id @default(uuid())
  name           String
  description    String?
  isDefault      Boolean         @default(false)
  stages         Json            @default("[]")
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineStages PipelineStage[]
  deals          Deal[]

  @@unique([name, tenantId])
  @@index([tenantId, isDefault])
  @@index([tenantId, createdAt])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  name        String
  order       Int
  probability Int      @default(0)
  color       String?  @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@unique([name, pipelineId])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

model Deal {
  id                String        @id @default(uuid())
  title             String
  description       String?
  value             Decimal       @db.Decimal(18, 2)
  currency          CurrencyCode  @default(INR)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  probability       Int           @default(10)
  source            String?
  tags              String[]      @default([])
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  tenantId          String
  pipelineId        String
  stageId           String
  contactId         String?
  organizationId    String?
  assignedTo        String?
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignee          User?         @relation("DealAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  activities        CrmActivity[]

  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([tenantId, contactId])
  @@index([tenantId, organizationId])
  @@index([tenantId, assignedTo])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, createdAt])
  @@map("deals")
}

model CrmActivity {
  id             String          @id @default(uuid())
  type           CrmActivityType
  subject        String
  description    String?
  dueDate        DateTime?
  completedAt    DateTime?
  duration       Int?
  outcome        String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  tenantId       String
  contactId      String?
  dealId         String?
  organizationId String?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@index([tenantId, dueDate])
  @@index([tenantId, completedAt])
  @@index([tenantId, createdAt])
  @@map("crm_activities")
}

// ============================================
// Volunteer Models
// ============================================

model Volunteer {
  id               String            @id @default(uuid())
  userId           String?
  firstName        String
  lastName         String
  email            String            @db.Citext
  phone            String?
  mobile           String?
  whatsapp         String?
  dateOfBirth      DateTime?
  gender           Gender?
  address          Json?
  emergencyContact Json?
  occupation       String?
  employer         String?
  education        String?
  skills           String[]          @default([])
  interests        String[]          @default([])
  languages        String[]          @default([])
  availability     Json?
  status           VolunteerStatus   @default(ACTIVE)
  joinDate         DateTime?
  source           String?
  referralSource   String?
  tags             String[]          @default([])
  notes            String?
  documents        Json              @default("[]")
  metadata         Json?
  totalHours       Decimal           @default(0) @db.Decimal(10, 2)
  totalShifts      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftAssignments ShiftAssignment[]
  volunteerSkills  VolunteerSkill[]
  hoursLogs        HoursLog[]
  availabilities   Availability[]
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  certificates     Certificate[]

  @@unique([email, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("volunteers")
}

model Shift {
  id             String            @id @default(uuid())
  title          String
  description    String?
  location       String?
  startDateTime  DateTime
  endDateTime    DateTime
  timezone       String            @default("Asia/Kolkata")
  maxVolunteers  Int               @default(10)
  requiredSkills String[]          @default([])
  requiredRoles  String[]          @default([])
  isRecurring    Boolean           @default(false)
  recurrenceRule String?
