model ComplianceProfile {
  id               String    @id @default(uuid())
  tenantId         String    @unique
  legalName        String
  registrationNo   String?
  pan              String?
  address          Json?
  reg80G           String?
  reg80GValidFrom  DateTime?
  reg80GValidUntil DateTime?
  reg12A           String?
  csr1No           String?
  fcraNo           String?
  fcraValidUntil   DateTime?
  fcraVerifiedAt   DateTime?
  fcraVerifiedById String?
  signatoryName    String?
  signatoryTitle   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("compliance_profiles")
}

/// Each NGO connects its own gateway account. Secrets are AES-GCM encrypted.
model PaymentAccount {
  id               String              @id @default(uuid())
  tenantId         String
  provider         PaymentProviderCode
  fund             Fund                @default(DOMESTIC)
  keyId            String
  keySecretEnc     String
  webhookSecretEnc String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, fund])
  @@map("payment_accounts")
}

model Campaign {
  id               String         @id @default(uuid())
  tenantId         String
  slug             String
  title            String
  summary          String?
  story            String?
  coverFileId      String?
  goalMinor        BigInt         @default(0)
  currency         CurrencyCode   @default(INR)
  suggestedAmounts Int[]          @default([])
  status           CampaignStatus @default(DRAFT)
  is80GEligible    Boolean        @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donations        Donation[]
  subscriptions    Subscription[]
  events           Event[]
  socialPosts      SocialPost[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("campaigns")
}

model Donor {
  id               String         @id @default(uuid())
  tenantId         String
  userId           String?
  organizationId   String?
  type             DonorType      @default(INDIVIDUAL)
  fullName         String
  email            String?        @db.Citext
  phone            String?
  address          Json?
  panEnc           String?
  panLast4         String?
  isIndianCitizen  Boolean?
  marketingConsent Boolean        @default(false)
  notes            String?
  tags             String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  donations        Donation[]
  subscriptions    Subscription[]

  @@index([tenantId, email])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("donors")
}

model Donation {
  id             String         @id @default(uuid())
  tenantId       String
  donorId        String
  campaignId     String?
  subscriptionId String?
  amountMinor    BigInt
  refundedMinor  BigInt         @default(0)
  currency       CurrencyCode   @default(INR)
  fund           Fund           @default(DOMESTIC)
  method         PaymentMethod  @default(ONLINE)
  status         DonationStatus @default(CREATED)
  isAnonymous    Boolean        @default(false)
  wants80G       Boolean        @default(false)
  message        String?
  reference      String?
  publicToken    String         @unique
  recordedById   String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor          Donor          @relation(fields: [donorId], references: [id], onDelete: Restrict)
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments       Payment[]
  refunds        Refund[]
  receipts       Receipt[]
  ledgerEntries  LedgerEntry[]

  @@index([tenantId, status, completedAt])
  @@index([tenantId, donorId])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, createdAt])
  @@map("donations")
}

model Payment {
  id                String              @id @default(uuid())
  tenantId          String
  donationId        String
  provider          PaymentProviderCode
  providerOrderId   String?
  providerPaymentId String?
  amountMinor       BigInt
  feeMinor          BigInt              @default(0)
  currency          CurrencyCode        @default(INR)
  status            PaymentStatus       @default(CREATED)
  error             String?
  settledAt         DateTime?
  settlementRef     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donation          Donation            @relation(fields: [donationId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@unique([tenantId, provider, providerPaymentId])
  @@unique([tenantId, provider, providerOrderId])
  @@index([tenantId, status, settledAt])
  @@map("payments")
}

model ProviderEvent {
  id          String              @id @default(uuid())
  tenantId    String
  provider    PaymentProviderCode
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime            @default(now())

  @@unique([tenantId, provider, eventId])
  @@map("provider_events")
}

model Refund {
  id               String       @id @default(uuid())
  tenantId         String
  donationId       String
  paymentId        String
  providerRefundId String?
  amountMinor      BigInt
  reason           String?
  status           RefundStatus @default(PENDING)
  requestedById    String?
  processedAt      DateTime?
  error            String?
  createdAt        DateTime     @default(now())
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donation         Donation     @relation(fields: [donationId], references: [id], onDelete: Restrict)
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, providerRefundId])
  @@index([tenantId, donationId])
  @@map("refunds")
}

model Subscription {
  id                     String               @id @default(uuid())
  tenantId               String
  donorId                String
  campaignId             String?
  amountMinor            BigInt
  currency               CurrencyCode         @default(INR)
  interval               SubscriptionInterval @default(MONTHLY)
  status                 SubscriptionStatus   @default(CREATED)
  provider               PaymentProviderCode
  providerSubscriptionId String?
  wants80G               Boolean              @default(false)
  nextChargeAt           DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor                  Donor                @relation(fields: [donorId], references: [id], onDelete: Restrict)
  campaign               Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  donations              Donation[]

  @@unique([tenantId, provider, providerSubscriptionId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model Receipt {
  id         String        @id @default(uuid())
  tenantId   String
  donationId String
  kind       ReceiptKind
  fiscalYear String
  seq        Int
  number     String
  status     ReceiptStatus @default(ISSUED)
  snapshot   Json
  issuedAt   DateTime      @default(now())
  voidedAt   DateTime?
  voidReason String?
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donation   Donation      @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, kind, fiscalYear, seq])
  @@unique([tenantId, number])
  @@index([donationId])
  @@map("receipts")
}

model ReceiptCounter {
  tenantId   String
  kind       ReceiptKind
  fiscalYear String
  lastSeq    Int         @default(0)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind, fiscalYear])
  @@map("receipt_counters")
}

model LedgerEntry {
  id          String        @id @default(uuid())
  tenantId    String
  journalId   String
  account     LedgerAccount
  fund        Fund          @default(DOMESTIC)
  debitMinor  BigInt        @default(0)
  creditMinor BigInt        @default(0)
  donationId  String?
  grantId     String?
  narration   String
  occurredAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donation    Donation?     @relation(fields: [donationId], references: [id], onDelete: Restrict)
  grant       Grant?        @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@index([tenantId, fund, occurredAt])
  @@index([journalId])
  @@map("ledger_entries")
}

