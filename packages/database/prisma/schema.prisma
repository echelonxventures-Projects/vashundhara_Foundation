  hoursLogs      HoursLog[]

  @@index([tenantId, status])
  @@index([tenantId, startDateTime])
  @@index([tenantId, location])
  @@index([tenantId, createdAt])
  @@map("shifts")
}

model ShiftAssignment {
  id            String           @id @default(uuid())
  shiftId       String
  volunteerId   String
  status        AssignmentStatus @default(REGISTERED)
  role          String?
  checkInTime   DateTime?
  checkOutTime  DateTime?
  hoursCredited Decimal          @default(0) @db.Decimal(6, 2)
  notes         String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  tenantId      String
  shift         Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteer     Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([shiftId, volunteerId])
  @@index([tenantId, shiftId])
  @@index([tenantId, volunteerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("shift_assignments")
}

model Skill {
  id               String           @id @default(uuid())
  name             String
  category         String?
  description      String?
  isCertifiable    Boolean          @default(false)
  certificationUrl String?
  tags             String[]         @default([])
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  volunteerSkills  VolunteerSkill[]

  @@unique([name, tenantId])
  @@index([tenantId, category])
  @@index([tenantId, createdAt])
  @@map("skills")
}

model VolunteerSkill {
  id               String           @id @default(uuid())
  volunteerId      String
  skillId          String
  proficiency      ProficiencyLevel @default(BEGINNER)
  certified        Boolean          @default(false)
  certifiedAt      DateTime?
  certificationUrl String?
  verifiedBy       String?
  verifiedAt       DateTime?
  notes            String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  volunteer        Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, skillId])
  @@index([skillId])
  @@map("volunteer_skills")
}

model HoursLog {
  id           String         @id @default(uuid())
  volunteerId  String
  shiftId      String?
  date         DateTime
  hours        Decimal        @db.Decimal(6, 2)
  description  String?
  activityType ActivityType   @default(SHIFT)
  location     String?
  verifiedBy   String?
  verifiedAt   DateTime?
  status       HoursLogStatus @default(PENDING)
  tags         String[]       @default([])
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  tenantId     String
  volunteer    Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  shift        Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, volunteerId])
  @@index([tenantId, shiftId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, activityType])
  @@index([tenantId, createdAt])
  @@map("hours_logs")
}

model Availability {
  id          String    @id @default(uuid())
  volunteerId String
  dayOfWeek   Int
  startTime   String
  endTime     String
  timezone    String    @default("Asia/Kolkata")
  isRecurring Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  notes       String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenantId    String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, volunteerId])
  @@index([tenantId, dayOfWeek])
  @@map("availabilities")
}

