  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("beneficiary_cases")
}

model AidRecord {
  id            String      @id @default(uuid())
  tenantId      String
  beneficiaryId String
  type          AidType
  description   String
  valueMinor    BigInt      @default(0)
  quantity      Decimal?    @db.Decimal(12, 2)
  unit          String?
  givenAt       DateTime
  givenById     String?
  grantId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  grant         Grant?      @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([tenantId, givenAt])
  @@map("aid_records")
}

/// clientId is generated on the device so offline uploads can be retried safely.
model FieldVisit {
  id            String       @id @default(uuid())
  tenantId      String
  clientId      String
  workerId      String
  beneficiaryId String?
  purpose       String
  notes         String?
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  accuracyM     Int?
  photoFileIds  String[]     @default([])
  visitedAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, clientId])
  @@index([tenantId, workerId, visitedAt])
  @@map("field_visits")
}

model FieldAttendance {
  id         String   @id @default(uuid())
  tenantId   String
  clientId   String
  workerId   String
  kind       String
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  recordedAt DateTime
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId, workerId, recordedAt])
  @@map("field_attendance")
}

model Certificate {
  id          String    @id @default(uuid())
  tenantId    String
  volunteerId String
  code        String    @unique
  title       String
  hours       Decimal   @db.Decimal(10, 2)
  issuedAt    DateTime  @default(now())
  revokedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([tenantId, volunteerId])
  @@map("certificates")
}

// ============================================
// CSR and grants
// ============================================

enum GrantStatus {
  PROPOSED
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Grant {
  id             String             @id @default(uuid())
  tenantId       String
  organizationId String
  title          String
  description    String?
  amountMinor    BigInt
  status         GrantStatus        @default(PROPOSED)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  utilisations   GrantUtilisation[]
  invoices       Invoice[]
  aidRecords     AidRecord[]
  ledgerEntries  LedgerEntry[]

  @@index([tenantId, organizationId])
  @@map("grants")
}

model GrantUtilisation {
  id          String    @id @default(uuid())
  tenantId    String
  grantId     String
  amountMinor BigInt
  category    String
  description String
  fileId      String?
  spentAt     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grant       Grant     @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([tenantId, grantId])
  @@map("grant_utilisations")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  organizationId String
  grantId        String?
  number         String
  amountMinor    BigInt
  status         InvoiceStatus @default(DRAFT)
  dueAt          DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grant          Grant?        @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@map("invoices")
}

// ============================================
// Content
// ============================================

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id          String     @id @default(uuid())
  tenantId    String
  slug        String
  locale      LocaleCode @default(en)
  kind        String     @default("page")
  title       String
  excerpt     String?
  body        String
  status      PageStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug, locale])
  @@index([tenantId, kind, status])
  @@map("pages")
}

model Redirect {
  id        String   @id @default(uuid())
  tenantId  String
  fromPath  String
  toPath    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromPath])
  @@map("redirects")
}

model ContactMessage {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  message   String
  handledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id               String    @id @default(uuid())
  tenantId         String
  email            String    @db.Citext
  unsubscribeToken String    @unique
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("newsletter_subscribers")
}

// ============================================
// Privacy (DPDP)
// ============================================

enum DataRequestType {
  ACCESS
  CORRECTION
  ERASURE
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model ConsentRecord {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  email     String?  @db.Citext
  purpose   String
  version   String
  granted   Boolean
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email, purpose])
  @@map("consent_records")
}

model DataRequest {
  id          String            @id @default(uuid())
  tenantId    String
  userId      String
  type        DataRequestType
  status      DataRequestStatus @default(OPEN)
  details     String?
  resolution  String?
  handledById String?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("data_requests")
}

// ============================================
// Infrastructure
// ============================================

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  DEAD
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  tenantId    String?
  dedupeKey   String?   @unique
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(6)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
  @@map("jobs")
}

model PushSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

model ReportSchedule {
  id         String    @id @default(uuid())
  tenantId   String
  report     String
  frequency  String
  recipients String[]
  isActive   Boolean   @default(true)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@map("report_schedules")
}

// ============================================
// Events, learning, library, feedback, social, monitoring
// ============================================

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}

enum StudentStatus {
  APPLIED
  ACTIVE
  GRADUATED
  DROPPED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum FeedbackStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum SocialStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

model Event {
  id            String              @id @default(uuid())
  tenantId      String
  campaignId    String?
  slug          String
  title         String
  summary       String?
  description   String?
  venue         String?
  onlineUrl     String?
  coverFileId   String?
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int                 @default(0)
  status        EventStatus         @default(DRAFT)
  campaign      Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status, startsAt])
  @@map("events")
}

model EventRegistration {
  id          String             @id @default(uuid())
  tenantId    String
  eventId     String
  userId      String?
  name        String
  email       String             @db.Citext
  phone       String?
  status      RegistrationStatus @default(REGISTERED)
  ticketCode  String             @unique
  checkedInAt DateTime?
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([tenantId, status])
  @@map("event_registrations")
}

model Student {
  id                String            @id @default(uuid())
  tenantId          String
  userId            String?
  fullName          String
  email             String?           @db.Citext
  phone             String?
  guardianName      String?
  guardianPhone     String?
  guardianConsentAt DateTime?
  dateOfBirth       DateTime?
  gender            Gender?
  grade             String?
  school            String?
  status            StudentStatus     @default(APPLIED)
  notes             String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrolments        Enrolment[]
  submissions       Submission[]
  attendance        ClassAttendance[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@map("students")
}

model Course {
  id          String        @id @default(uuid())
  tenantId    String
  slug        String
  title       String
  summary     String?
  description String?
  level       String?
  language    LocaleCode    @default(en)
  teacherId   String?
  status      PublishStatus @default(DRAFT)
  lessons     Lesson[]
  enrolments  Enrolment[]
  liveClasses LiveClass[]
  assignments Assignment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("courses")
}

model Lesson {
  id        String           @id @default(uuid())
  tenantId  String
  courseId  String
  title     String
  body      String?
  videoUrl  String?
  fileId    String?
  order     Int              @default(0)
  status    PublishStatus    @default(DRAFT)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, courseId, order])
  @@map("lessons")
}

model Enrolment {
  id          String           @id @default(uuid())
  tenantId    String
  courseId    String
  studentId   String
  status      EnrolmentStatus  @default(ACTIVE)
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([tenantId, status])
  @@map("enrolments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  tenantId    String
  enrolmentId String
  lessonId    String
  completedAt DateTime?
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([enrolmentId, lessonId])
  @@map("lesson_progress")
}

model LiveClass {
  id           String            @id @default(uuid())
  tenantId     String
  courseId     String
  title        String
  meetingUrl   String
  startsAt     DateTime
  endsAt       DateTime
  recordingUrl String?
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendance   ClassAttendance[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@map("live_classes")
}

model ClassAttendance {
  id          String    @id @default(uuid())
  tenantId    String
  liveClassId String
  studentId   String
  present     Boolean   @default(true)
  joinedAt    DateTime?
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@map("class_attendance")
}

model Assignment {
  id           String        @id @default(uuid())
  tenantId     String
  courseId     String
  title        String
  instructions String
  maxScore     Int           @default(100)
  dueAt        DateTime?
  fileId       String?
  status       PublishStatus @default(DRAFT)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, courseId])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid())
  tenantId     String
  assignmentId String
  studentId    String
  text         String?
  fileId       String?
  status       SubmissionStatus @default(SUBMITTED)
  isLate       Boolean          @default(false)
  score        Int?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  submittedAt  DateTime         @default(now())
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([tenantId, status])
  @@map("submissions")
}

model LibraryItem {
  id          String          @id @default(uuid())
  tenantId    String
  title       String
  author      String?
  description String?
  category    String?
  language    LocaleCode      @default(en)
  tags        String[]        @default([])
  fileId      String?
  externalUrl String?
  isPublic    Boolean         @default(false)
  status      PublishStatus   @default(DRAFT)
  accesses    LibraryAccess[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, category])
  @@map("library_items")
}

model LibraryAccess {
  id        String      @id @default(uuid())
  tenantId  String
  itemId    String
  userId    String?
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId, createdAt])
  @@map("library_accesses")
}

model Feedback {
  id            String         @id @default(uuid())
  tenantId      String
  subjectType   String
  subjectId     String
  userId        String?
  authorName    String?
  rating        Int
  comment       String?
  status        FeedbackStatus @default(PENDING)
  reply         String?
  moderatedById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, subjectType, subjectId, userId])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId, status])
  @@map("feedback")
}

model SocialPost {
  id            String       @id @default(uuid())
  tenantId      String
  campaignId    String?
  title         String
  body          String
  channels      String[]     @default([])
  hashtags      String[]     @default([])
  mediaFileIds  String[]     @default([])
  status        SocialStatus @default(DRAFT)
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  scheduledAt   DateTime?
  publishedAt   DateTime?
  publishedUrls Json?
  error         String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@map("social_posts")
}

model Programme {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  budgetMinor BigInt        @default(0)
  status      PublishStatus @default(DRAFT)
  indicators  Indicator[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("programmes")
}

model Indicator {
  id          String             @id @default(uuid())
  tenantId    String
  programmeId String
  name        String
  unit        String
  baseline    Decimal            @default(0) @db.Decimal(14, 2)
  target      Decimal            @db.Decimal(14, 2)
  programme   Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  readings    IndicatorReading[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, programmeId])
  @@map("indicators")
}

model IndicatorReading {
  id           String    @id @default(uuid())
  tenantId     String
  indicatorId  String
  value        Decimal   @db.Decimal(14, 2)
  note         String?
  recordedById String?
  recordedAt   DateTime
  indicator    Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, indicatorId, recordedAt])
  @@map("indicator_readings")
}

/// What Super Admin lets an NGO do with its own structure. Only the platform console writes this.
model StructurePolicy {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  ngoAdminAllowed Boolean  @default(false)
  /// Off: Super Admin reviews and approves every publish. On: the NGO Administrator publishes directly.
  ngoAdminPublish Boolean  @default(false)
  maxFields       Int      @default(150)
  maxTables       Int      @default(20)
  maxForms        Int      @default(20)
  maxRules        Int      @default(20)
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("structure_policies")
}

/// One NGO's fields, layout, tables, forms and rules. At most one DRAFT and one PUBLISHED per NGO.
model StructureVersion {
  id          String          @id @default(uuid())
  tenantId    String
  number      Int?
  status      StructureStatus @default(DRAFT)
  definition  Json
  rev         Int             @default(1)
  note        String?
  createdById String?
  /// Set while a draft waits for Super Admin. Kept on the published version as the record of who asked.
  submittedAt   DateTime?
  submittedById String?
  submitNote    String?
  /// Why Super Admin sent the draft back.
  reviewNote    String?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("structure_versions")
}

enum StructureStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// Extra field values on built-in records. Kept apart so public pages can never show them by accident.
model CustomValue {
  id        String   @id @default(uuid())
  tenantId  String
  entity    String
  recordId  String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, recordId])
  @@index([data(ops: JsonbPathOps)], type: Gin)
  @@map("custom_values")
}

/// A row in one of an NGO's own tables.
model CustomRecord {
  id          String    @id @default(uuid())
  tenantId    String
  tableKey    String
  title       String
  data        Json      @default("{}")
  source      String    @default("STAFF")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tableKey, createdAt])
  @@index([data(ops: JsonbPathOps)], type: Gin)
  @@map("custom_records")
}

/// A reusable structure owned by the platform.
model StructureTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  definition  Json
  isDefault   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("structure_templates")
}
